library ieee;
use ieee.std_logic_1164.all;

entity NX_FIFO_DPREG is
generic (
    wck_edge       : std_logic := '0';
    rck_edge       : std_logic := '0';
    use_write_arst : std_logic := '0';
    use_read_arst  : std_logic := '0';
    read_addr_inv  : std_logic_vector(5 downto 0) := "000000"
);
port (
    RCK   : in  std_logic;
    WCK   : in  std_logic;
    WE    : in  std_logic;
    WEA   : in  std_logic;
    I     : in  std_logic_vector(17 downto 0);
    O     : out std_logic_vector(17 downto 0);
    WRSTI : in  std_logic;
    WAI   : in  std_logic_vector(5 downto 0);
    WRSTO : out std_logic;
    WAO   : out std_logic_vector(5 downto 0);
    WEQ   : out std_logic;
    RRSTI : in  std_logic;
    RAI   : in  std_logic_vector(5 downto 0);
    RRSTO : out std_logic;
    RAO   : out std_logic_vector(5 downto 0);
    REQ   : out std_logic
);
end NX_FIFO_DPREG;

architecture NX_RTL of NX_FIFO_DPREG is
    attribute NX_TYPE :string;
    attribute NX_TYPE of NX_RTL: architecture is "WRAPPER";

