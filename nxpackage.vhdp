    dpram_clkmem0_i          : in  std_logic;                           -- RAM.ACK
    dpram_clkmemclone0_i     : in  std_logic;                           -- RAM.ACKC
    dpram_clkmem90_0_i       : in  std_logic;                           -- RAM.ACKD
