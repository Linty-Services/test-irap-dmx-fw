    --                                                  9         0                 bypass cascade Z output dff       (cz_pr)
    --                                                 10          0                bypass Y dff                       (y_pr)
    --                                                 11           0               bypass X dff                       (x_pr)
    --                                                 12            0              bypass carry input dff           (cyi_pr)
    --                                                 13             0             bypass multiplier dff              (m_pr)
    --                                                 14              0            bypass pre-adder dff               (p_pr)
    --                                                 15               0           bypass input D dff                 (d_pr)
    --                                                 16                0          bypass input C dff                 (c_pr)
    --                                                 17                 00        X0->bypass ; 01->1dff ; 11->2dff cascade output B
    --                                                 18                   00      X0->bypass ; 01->1dff ; 11->2dff B
    --                                                 19                     00    X0->bypass ; 01->1dff ; 11->2dff cascade output A
    --                                                 20                       00  X0->bypass ; 01->1dff ; 11->2dff A
    function raw_config1_0 return bit_vector is
        constant result : bit_vector(23 downto 0) := "000000010000001100010001";
    begin
        return result;
    end function;
    function raw_config1_1 return bit_vector is
        constant result : bit_vector(23 downto 0) := "000000010011001100110011";
    begin
        return result;
    end function;
    --
    -- constant raw_config2 : bit_vector(13 downto 0) := "01010000001111";
    --                                                   "00010001011111";
    --                                                 19 1               enable ovf reset                        (ovf_pr)
    --                                                 20  1              enable carry out reset                  (cyo_pr)
    --                                                 21   1             enable cascade carry out reset         (ccyo_pr)
    --                                                 22    1            enable Z out reset                        (z_pr)
    --                                                 23     1           enable cascade Z output/loopback reset   (cz_pr)
    --                                                 27      1          enable multiplier output reset            (m_pr)
    --                                                 24       1         enable Y reset                            (y_pr)
    --                                                 25        1        enable X reset                            (x_pr)
    --                                                 28         1       enable pre-adder output reset             (p_pr)
    --                                                 26          1      enable carry input reset                (cyi_pr)
    --                                                 29           1     enable D dff reset                        (d_pr)
    --                                                 30            1    enable C dff reset                        (c_pr)
    --                                                 31             1   enable B dff reset                        (b_pr)
    --                                                 32              1  enable A dff reset                        (a_pr)
    function raw_config2_0 return bit_vector is
        constant result : bit_vector(13 downto 0) := "01010000001111";
    begin
        return result;
    end function;
    function raw_config2_1 return bit_vector is
        constant result : bit_vector(13 downto 0) := "00010001011111";
    begin
        return result;
    end function;

    -- input pipes outside dsp
    ----signal PX : std_logic_vector(23 downto 0);
    ----signal PY : std_logic_vector(17 downto 0);
    -- cascade output from one dsp to another
    signal C0 : std_logic;
    ----signal C1 : std_logic_vector(55 downto 0);
    ----signal C2 : std_logic_vector(55 downto 0);
    -- output pipes outside dsp
    ----type t_pipe_0 is array (2 downto 0) of std_logic_vector(17 downto 0);
    ----type t_pipe_1 is array (1 downto 0) of std_logic_vector(5 downto 0);
    ----signal P0 : t_pipe_0;
    ----signal P1 : t_pipe_1;
    ----signal P2 : std_logic_vector(17 downto 0);
    -- dsp outputs
    signal Z0 : std_logic_vector(55 downto 0);
    signal Z0_r : std_logic_vector(41 downto 0);
    signal Z1 : std_logic_vector(55 downto 0);

    signal A1 : std_logic_vector(23 downto 0);
    signal B1 : std_logic_vector(17 downto 0);
    signal C1 : std_logic_vector(35 downto 0);
    signal D1 : std_logic_vector(17 downto 0);

    signal A2 : std_logic_vector(23 downto 0);
    signal B2 : std_logic_vector(17 downto 0);
    signal C2 : std_logic_vector(35 downto 0);
    signal D2 : std_logic_vector(17 downto 0);

    begin

        A1 <= Y(41 downto 18);
        B1 <= Y(17 downto 0);
        C1 <= "00"&X(33 downto 0);
        D1 <= "0000000000"&X(41 downto 34);

        A2 <= Y(83 downto 60);
        B2 <= Y(59 downto 42);
        C2 <= "00"&X(75 downto 42);
        D2 <= "0000000000"&X(83 downto 76);

        dsp_mult_0 : NX_DSP_U_WRAP
        generic map(
            raw_config0 => raw_config0_0,  -- bit_vector(26 downto 0);
            raw_config1 => raw_config1_0,  -- bit_vector(23 downto 0);
            raw_config2 => raw_config2_0,  -- bit_vector(13 downto 0);
            raw_config3 => (others => '0') -- bit_vector(2 downto 0)
        )
        port map(
            CK   => clk,
            R    => rst,
            RZ   => rst,
            WE   => '1',
            WEZ  => '1',

            CI   => '0',
            A    => A1,--Y(41 downto 18),
            B    => B1,--Y(17 downto 0),
            C    => C1,--X(33 downto 0),
            D    => D1,--X(41 downto 34),
            CAI  => (others => '0'),
            CBI  => (others => '0'),
            CZI  => (others => '0'),
            CCI  => '0',

            Z    => Z0,
            CO43 => open,
            CO57 => open,
            OVF  => open,
            CAO  => open,
            CBO  => open,
            CZO  => open,
            CCO  => C0
        );

        dsp_mult_1 : NX_DSP_U_WRAP
        generic map(
            raw_config0 => raw_config0_1,  -- bit_vector(26 downto 0);
            raw_config1 => raw_config1_1,  -- bit_vector(23 downto 0);
            raw_config2 => raw_config2_1,  -- bit_vector(13 downto 0);
            raw_config3 => (others => '0') -- bit_vector(2 downto 0)
        )
        port map(
            CK   => clk,
            R    => rst,
            RZ   => rst,
            WE   => '1',
            WEZ  => '1',

            CI   => '0',
            A    => A2,--Y(83 downto 60),
            B    => B2,--Y(59 downto 42),
            C    => C2,--X(75 downto 42),
            D    => D2,--X(83 downto 76),
            CAI  => (others => '0'),
            CBI  => (others => '0'),
            CZI  => (others => '0'),
            CCI  => C0,

            Z    => Z1,
            CO43 => open,
            CO57 => open,
            OVF  => open,
            CAO  => open,
            CBO  => open,
            CZO  => open,
            CCO  => open
        );

        input_pipe : process (clk)
            begin
                if rising_edge(clk) then
                    Z0_r <= Z0(41 downto 0);
                end if;
            end process input_pipe;

        Z(41 downto 0)  <= Z0_r;
        Z(84 downto 42) <= Z1(42 downto 0);

end architecture;
-- =================================================================================================
--   NX_DSPDPRAM_FULL_U definition                                                       2020/02/03
-- =================================================================================================

-- NX_DSPDPRAM_FULL_U#{{{#
library ieee;
use ieee.std_logic_1164.all;

library NX;
use NX.nxPackage.all;

entity NX_DSPDPRAM_FULL_U is
generic (
    col    : integer := 2;
    row    : integer := 6;
    cfg_bot_i : bit_vector(95 downto 0) := (others => '0');
    cfg_top_i : bit_vector(95 downto 0) := (others => '0')
);
port (
    dsp0_clk_i  : in  std_logic;                                        -- DSP1.CK
    dsp0_rst_i  : in  std_logic; -- rst_i  et rstsys_i                  -- DSP1.R
    dsp0_rstz_i : in  std_logic; -- rstz_i et rstzsys_i                 -- DSP1.RZ
    dsp0_we_i   : in  std_logic; -- we_i   et wesys_i                   -- DSP1.WE
    dsp0_wez_i  : in  std_logic; -- wez_i  et wezsys_i                  -- DSP1.WEZ
    dsp0_cy_i   : in  std_logic;                                        -- DSP1.CI
    dsp0_a_i    : in  std_logic_vector(23 downto 0);                    -- DSP1.A
    dsp0_b_i    : in  std_logic_vector(17 downto 0);                    -- DSP1.B
    dsp0_c_i    : in  std_logic_vector(35 downto 0);                    -- DSP1.C
    dsp0_d_i    : in  std_logic_vector(17 downto 0);                    -- DSP1.D

    dsp0_z_o    : out std_logic_vector(55 downto 0);                    -- DSP1.Z
    dsp0_cy_o   : out std_logic;                                        -- DSP1.RESERVED
    dsp0_cy42_o : out std_logic;                                        -- DSP1.CO43
    dsp0_cy56_o : out std_logic;                                        -- DSP1.CO57
    dsp0_ovf_o  : out std_logic;                                        -- DSP1.OVF

    dsp1_clk_i  : in  std_logic;                                        -- DSP2.CK
    dsp1_rst_i  : in  std_logic; -- rst_i  et rstsys_i                  -- DSP2.R
    dsp1_rstz_i : in  std_logic; -- rstz_i et rstzsys_i                 -- DSP2.RZ
    dsp1_we_i   : in  std_logic; -- we_i   et wesys_i                   -- DSP2.WE
    dsp1_wez_i  : in  std_logic; -- wez_i  et wezsys_i                  -- DSP2.WE
    dsp1_cy_i   : in  std_logic;                                        -- DSP2.CI
    dsp1_a_i    : in  std_logic_vector(23 downto 0);                    -- DSP2.A
    dsp1_b_i    : in  std_logic_vector(17 downto 0);                    -- DSP2.B
    dsp1_c_i    : in  std_logic_vector(35 downto 0);                    -- DSP2.C
    dsp1_d_i    : in  std_logic_vector(17 downto 0);                    -- DSP2.D

    dsp1_z_o    : out std_logic_vector(55 downto 0);                    -- DSP2.Z
    dsp1_cy_o   : out std_logic;                                        -- DSP2.RESERVED
    dsp1_cy42_o : out std_logic;                                        -- DSP2.CO43
    dsp1_cy56_o : out std_logic;                                        -- DSP2.CO57
    dsp1_ovf_o  : out std_logic;                                        -- DSP2.OVF

    dpram_clkmem0_i          : in  std_logic;                           -- RAM.ACK
    dpram_rst0_i             : in  std_logic; -- rst_i et rstsys_i      -- RAM.AR
    dpram_cs0_i              : in  std_logic; -- cs_i  et cssys_i       -- RAM.ACS
    dpram_we0_i              : in  std_logic; -- we_i  et wesys_i       -- RAM.AWE
    dpram_addr0_i            : in  std_logic_vector(15 downto 0);       -- RAM.AA
    dpram_din0_i             : in  std_logic_vector(23 downto 0);       -- RAM.AI
    dpram_dout0_o            : out std_logic_vector(23 downto 0);       -- RAM.AO
    dpram_ecc_corrected0_o   : out std_logic;                           -- RAM.ACOR
    dpram_ecc_uncorrected0_o : out std_logic;                           -- RAM.AERR

    dpram_clkmem1_i          : in  std_logic;                           -- RAM.BCK
    dpram_rst1_i             : in  std_logic; -- rst_i et rstsys_i      -- RAM.BR
    dpram_cs1_i              : in  std_logic; -- cs_i  et cssys_i       -- RAM.BCS
    dpram_we1_i              : in  std_logic; -- we_i  et wesys_i       -- RAM.BWE
    dpram_addr1_i            : in  std_logic_vector(15 downto 0);       -- RAM.BA
    dpram_din1_i             : in  std_logic_vector(23 downto 0);       -- RAM.BI
    dpram_dout1_o            : out std_logic_vector(23 downto 0);       -- RAM.BO
    dpram_ecc_corrected1_o   : out std_logic;                           -- RAM.BCOR
    dpram_ecc_uncorrected1_o : out std_logic                            -- RAM.BERR
);
end NX_DSPDPRAM_FULL_U;
