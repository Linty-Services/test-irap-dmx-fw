            CZI  => (others => '0'),
            CCI  => C0,

            Z    => Z1,
            CO43 => open,
            CO57 => open,
            OVF  => open,
            CAO  => open,
            CBO  => open,
            CZO  => open,
            CCO  => open
        );

        input_pipe : process (clk)
            begin
                if rising_edge(clk) then
                    Z0_r <= Z0(41 downto 0);
                end if;
            end process input_pipe;
        
        --Z(41 downto 0)  <= Z0_r;
        Z(41 downto 0)  <= Z0(41 downto 0);
        Z(84 downto 42) <= Z1(42 downto 0);

