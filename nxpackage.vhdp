    signal B : std_logic_vector(17 downto 0);
    signal C : std_logic_vector(35 downto 0);
    signal D : std_logic_vector(17 downto 0);

    begin

        A <= Y(41 downto 18);
        B <= Y(17 downto 0);
        C <= "00"&X(33 downto 0);
        D <= "0000000000"&X(41 downto 34);

        dsp_mult_0 : NX_DSP_U_WRAP
        generic map(
            raw_config0 => b"000010000000001011000000000",  -- bit_vector(26 downto 0);
            raw_config1 => b"000000010001001100010001",  -- bit_vector(23 downto 0);
