-- =================================================================================================
--   NX_CDC_L_2DFF definition
-- =================================================================================================
library ieee;
use ieee.std_logic_1164.all;
use IEEE.STD_LOGIC_arith.ALL;
use IEEE.STD_LOGIC_unsigned.ALL;

entity NX_CDC_L_2DFF is 
generic (
  ck0_edge        : bit := '0';
  ck1_edge        : bit := '0';
  ack_sel        : bit := '0';
  bck_sel        : bit := '0';
  use_adest_arst : bit_vector(1 downto 0) := "00";
  use_bdest_arst : bit_vector(1 downto 0) := "00";
  gt0_bypass_reg1 :bit := '0';
  gt0_bypass_reg2 :bit := '0';
  gt1_bypass_reg1 :bit := '0';
  gt1_bypass_reg2 :bit := '0'
);
port (
  CK1    : in  std_logic;
  CK2    : in  std_logic;
  ADRSTI : in  std_logic;
  AI     : in  std_logic_vector(5 downto 0);
  AO     : out std_logic_vector(5 downto 0);
  BDRSTI : in  std_logic;
  BI     : in  std_logic_vector(5 downto 0);
  BO     : out std_logic_vector(5 downto 0)
);
end NX_CDC_L_2DFF;

architecture NX_RTL of NX_CDC_L_2DFF is
    attribute NX_TYPE :string;
    attribute NX_TYPE of NX_RTL: architecture is "WRAPPER";

component NX_CDC_L is
generic (
    mode           : integer := 0;
    ck0_edge        : bit := '0';
    ck1_edge        : bit := '0';
    ack_sel        : bit := '0';
    bck_sel        : bit := '0';
    cck_sel        : bit := '0';
    dck_sel        : bit := '0';
    use_asrc_arst  : bit_vector(1 downto 0) := "00";
    use_adest_arst : bit_vector(1 downto 0) := "00";
    use_bsrc_arst  : bit_vector(1 downto 0) := "00";
    use_bdest_arst : bit_vector(1 downto 0) := "00";
    use_csrc_arst  : bit_vector(1 downto 0) := "00";
    use_cdest_arst : bit_vector(1 downto 0) := "00";
    use_dsrc_arst  : bit_vector(1 downto 0) := "00";
    use_ddest_arst : bit_vector(1 downto 0) := "00";
    gt0_bypass_reg1 :bit := '0';
    gt0_bypass_reg2 :bit := '0';
    gt1_bypass_reg1 :bit := '0';
    gt1_bypass_reg2 :bit := '0';
    link_BA        : bit := '0';
    link_CB        : bit := '0';
    link_DC        : bit := '0'
);
port (
    CK1    : in  std_logic;
    CK2    : in  std_logic;
    --ASRSTI : in  std_logic;
    --ADRSTI : in  std_logic;
    AI1    : in  std_logic;
    AI2    : in  std_logic;
    AI3    : in  std_logic;
    AI4    : in  std_logic;
    AI5    : in  std_logic;
    AI6    : in  std_logic;
    AO1    : out std_logic;
    AO2    : out std_logic;
    AO3    : out std_logic;
    AO4    : out std_logic;
    AO5    : out std_logic;
    AO6    : out std_logic;
    --BSRSTI : in  std_logic;
    --BDRSTI : in  std_logic;
    BI1    : in  std_logic;
    BI2    : in  std_logic;
    BI3    : in  std_logic;
    BI4    : in  std_logic;
    BI5    : in  std_logic;
    BI6    : in  std_logic;
    BO1    : out std_logic;
    BO2    : out std_logic;
    BO3    : out std_logic;
    BO4    : out std_logic;
    BO5    : out std_logic;
    BO6    : out std_logic;
    --CSRSTI : in  std_logic;
    --CDRSTI : in  std_logic;
    CI1    : in  std_logic;
    CI2    : in  std_logic;
    CI3    : in  std_logic;
    CI4    : in  std_logic;
    CI5    : in  std_logic;
    CI6    : in  std_logic;
    CO1    : out std_logic;
    CO2    : out std_logic;
    CO3    : out std_logic;
    CO4    : out std_logic;
    CO5    : out std_logic;
    CO6    : out std_logic;
    --DSRSTI : in  std_logic;
    --DDRSTI : in  std_logic;
    DI1    : in  std_logic;
    DI2    : in  std_logic;
    DI3    : in  std_logic;
    DI4    : in  std_logic;
    DI5    : in  std_logic;
    DI6    : in  std_logic;
    DO1    : out std_logic;
    DO2    : out std_logic;
    DO3    : out std_logic;
    DO4    : out std_logic;
    DO5    : out std_logic;
    DO6    : out std_logic
);
end component;

begin

  cdc: NX_CDC_L
    generic map (
      mode           => 0, -- 0: 2DFF
      ck0_edge        => ck0_edge,
      ck1_edge        => ck1_edge,
      ack_sel        => ack_sel,
      bck_sel        => bck_sel,
      cck_sel        => '0',
      dck_sel        => '0',
      use_asrc_arst  => "00",
      use_adest_arst => use_adest_arst,
      use_bsrc_arst  => "00",
      use_bdest_arst => use_bdest_arst,
      use_csrc_arst  => "00",
      use_cdest_arst => "00",
      use_dsrc_arst  => "00",
      use_ddest_arst => "00",
      gt0_bypass_reg1=> '0',
      gt0_bypass_reg2=> '0',
      gt1_bypass_reg1=> '0',
      gt1_bypass_reg2=> '0',
      link_BA        => '0',
      link_CB        => '0',
      link_DC        => '0'
    )
    port map (
      CK1    => CK1,
      CK2    => CK2,
      --ASRSTI => '0',
      --ADRSTI => ADRSTI,
      AI1    => AI(0),
      AI2    => AI(1),
      AI3    => AI(2),
      AI4    => AI(3),
      AI5    => AI(4),
      AI6    => AI(5),
      AO1    => AO(0),
      AO2    => AO(1),
      AO3    => AO(2),
      AO4    => AO(3),
      AO5    => AO(4),
      AO6    => AO(5),
      --BSRSTI => '0',
      --BDRSTI => BDRSTI,
      BI1    => BI(0),
      BI2    => BI(1),
      BI3    => BI(2),
      BI4    => BI(3),
      BI5    => BI(4),
      BI6    => BI(5),
      BO1    => BO(0),
      BO2    => BO(1),
      BO3    => BO(2),
      BO4    => BO(3),
      BO5    => BO(4),
      BO6    => BO(5),
      --CSRSTI => '0',
      --CDRSTI => '0',
      CI1    => '0',
      CI2    => '0',
      CI3    => '0',
      CI4    => '0',
      CI5    => '0',
      CI6    => '0',
      CO1    => OPEN,
      CO2    => OPEN,
      CO3    => OPEN,
      CO4    => OPEN,
      CO5    => OPEN,
      CO6    => OPEN,
      --DSRSTI => '0',
      --DDRSTI => '0',
      DI1    => '0',
      DI2    => '0',
      DI3    => '0',
      DI4    => '0',
      DI5    => '0',
      DI6    => '0',
      DO1    => OPEN,
      DO2    => OPEN,
      DO3    => OPEN,
      DO4    => OPEN,
      DO5    => OPEN,
      DO6    => OPEN
    );
end NX_RTL;

