        )
        port map(
            CK   => clk,
            R    => rst,
            RZ   => rst,
            WE   => '1',
            WEZ  => '1',

            CI   => '0',
            A    => A1,
            B    => B1,
            C    => (others => '0'),
            D    => (others => '0'),
            CAI  => (others => '0'),
            CBI  => (others => '0'),
            CZI  => cascade_in,--shift_12,--cascade,
            CCI  => '0',

            Z    => Z1,
            CO43 => open,
            CO57 => open,
            OVF  => open,
            CAO  => open,
            CBO  => open,
            CZO  => cascade,
            CCO  => open
        );

        cascade_in <= cascade when nb_cycle = 1 else
                      cascade when nb_cycle = 3 else
                      "000000000000"&cascade(55 downto 12) when nb_cycle = 0 else
                      "000000000000"&cascade(55 downto 12) when nb_cycle = 2 else
                      (others => '0'); 

        ope_dyn1 : process (clk)
        begin
            if rising_edge(clk) then
                if (nb_cycle = 0 and start_ope_dyn_after_rst='1' and ((unsigned(A1) /= 0) or (unsigned(B1) /= 0)))then
                    if (flag_start = '1')then 
                        if (cpt = 3)then
                            nb_cycle <= nb_cycle +1;
                            --
                            flag_start <= '0';
                        else
                            cpt <= cpt +1;
                        end if;
                    else
                    nb_cycle <= nb_cycle +1;
                    end if;
                elsif (nb_cycle = 2)then
                    nb_cycle <= nb_cycle +1;
                elsif (nb_cycle = 1 or nb_cycle = 3)then
                    if (nb_cycle = 3)then
                        nb_cycle <= 0;
                    else
                    nb_cycle <= nb_cycle +1;
                    end if;     
                end if;
                    --
                if rst ='0'then
                    start_ope_dyn_after_rst <= '1';
                end if;
            end if;
        end process ope_dyn1;

        output_pipe : process (clk)
        begin
            if rising_edge(clk) then
                Z1_r1(0) <= Z1(17 downto 0);
                Z1_r1(1) <= Z1_r1(0);
                Z1_r1(2) <= Z1_r1(1);
                --
                Z1_r2(0) <= Z1(5 downto 0);
                Z1_r2(1) <= Z1_r2(0);
                --
                Z1_r3(0) <= Z1(17 downto 0);
            end if;
        end process output_pipe;
        
        Z(17 downto 0)  <= Z1_r1(2);
        Z(23 downto 18) <= Z1_r2(1);
        Z(41 downto 24) <= Z1_r3(0);
        Z(83 downto 42) <= Z1(41 downto 0);

end architecture;library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity UMUL48x36_4DSP is
    generic (
        piped : boolean := true
    );
    port (
        -- Global
        clk : in std_logic := '0';
        rst : in std_logic := '0';
        -- 
        A   : in std_logic_vector(47 downto 0);
        B   : in std_logic_vector(35 downto 0);
        Z   : out std_logic_vector(83 downto 0)
    );
end UMUL48x36_4DSP;

architecture rtl of UMUL48x36_4DSP is

    -- Component NX_DSP_U_WRAP#{{{#
    component NX_DSP_U_WRAP is
        generic (
            std_mode    : string                  := "";
            raw_config0 : bit_vector(26 downto 0) := B"000000000000000000000000000"; -- Mux
            raw_config1 : bit_vector(23 downto 0) := B"000000000000000000000000";    -- Pipe Mux
            raw_config2 : bit_vector(13 downto 0) := B"00000000000000";              -- Pipe Reset
            raw_config3 : bit_vector(2 downto 0)  := B"000"                          -- ALU operation
        );
        port (
            A    : in std_logic_vector(23 downto 0);
            B    : in std_logic_vector(17 downto 0);
            C    : in std_logic_vector(35 downto 0);
    
            CAI  : in std_logic_vector(23 downto 0);
            CAO  : out std_logic_vector(23 downto 0);
            CBI  : in std_logic_vector(17 downto 0);
            CBO  : out std_logic_vector(17 downto 0);
    
            CCI  : in std_logic;
            CCO  : out std_logic;
            CI   : in std_logic;
            CK   : in std_logic;
            CO43 : out std_logic;
            CO57 : out std_logic;
    
            CZI  : in std_logic_vector(55 downto 0);
            CZO  : out std_logic_vector(55 downto 0);
    
            D    : in std_logic_vector(17 downto 0);
    
            OVF  : out std_logic;
            R    : in std_logic;
            RZ   : in std_logic;
            WE   : in std_logic;
            WEZ  : in std_logic;
    
            Z    : out std_logic_vector(55 downto 0)
        );
    end component NX_DSP_U_WRAP;
    --#}}}#

    -- constant raw_config0 : bit_vector(26 downto 0) := "000000000000000000000000000";
    --                                                   "000000000000001000011100000";
    --                                                   "000000000000001000010000000";
    --                                                   "000000000000001000011100000";
    --                                                 33 1                            invert we
    --                                                 34  1                           invert wez
    --                                                 35   1                          invert rst
    --                                                 36    1                         invert rstz
    --                                                 45     0                        select bit42 pour cascade carry out (ccy_o)
    --                                                 41      1                       port C for dynamic operation
    --                                                 42       1                      port D for dynamic operation
    --                                                 43        xxxxxx                saturation rank
    --                                                 44              0               saturation {0->bypass ; 1->enable}
    --                                                 46               1              ALU {0->bypass ; 1->enable}
    --                                              50&51                00            cascade carry in {X0->input carry ; 01->cascade carry input ; 11->loopback carry}
    --                                                 48                              Y selector : {0->multiplier ; 1->A&B}
    --                                                 47                              Z input = {0->cascade ; 1->loopback}
    --                                                 49                              big mux selector
    --                                                 52                       0      0->bypass pre-adder ; 1->pre-adder
    --                                                 53                        0     0->B from core logic ; 1->B from cascade
    --                                                 54                         0    0->A from core logic ; 1->A from cascade
    --                                                 55                          0   pre-adder operation : {0->addition ; 1->substraction}
    --                                                 59                           1  signed mode
    function raw_config0_0 return bit_vector is
        constant result : bit_vector(26 downto 0) := "000000000000000000000000000";
    begin
        --return "000000000000000000000000000";
        return result;
    end function;
    --
    function raw_config0_1 return bit_vector is
        constant result : bit_vector(26 downto 0) := "000000000000001000011100000";
    begin
        --return "000000000000001000011100000";
        return result;
    end function;
    function raw_config0_2 return bit_vector is
        constant result : bit_vector(26 downto 0) := "000000000000001000010000000";
    begin
        --return "000000000000001000010000000";
        return result;
    end function;
    --
    function raw_config0_3 return bit_vector is
        constant result : bit_vector(26 downto 0) := "000000000000001000011100000";
    begin
        --return "000000000000001000011100000";
        return result;
    end function;
    --
    -- constant raw_config1 : bit_vector(23 downto 0) := "000000010000100000010001";
    --                                                   "000000010000100000110011";
    --                                                   "000000010100100000110011";
    --                                                   "000000010100100000110011";
    --                                                  1 0                         bypass we dff                     (we_pr)
    --                                                  2  0                        bypass wez dff                   (wez_pr)
    --                                                  3   0                       bypass rst dff                   (rst_pr)
    --                                                  4    0                      bypass rstz dff                 (rstz_pr)
    --                                                  5     0                     bypass ovf dff                   (ovf_pr)
    --                                                  6      0                    bypass carry output dff          (cyo_pr)
    --                                                  7       0                   bypass cascade carry output dff (ccyo_pr)
    --                                                  8        0                  bypass Z output dff                (z_pr)
    --                                                  9         0                 bypass cascade Z output dff       (cz_pr)
    --                                                 10          0                bypass Y dff                       (y_pr)
    --                                                 11           0               bypass X dff                       (x_pr)
    --                                                 12            0              bypass carry input dff           (cyi_pr)
    --                                                 13             0             bypass multiplier dff              (m_pr)
    --                                                 14              0            bypass pre-adder dff               (p_pr)
    --                                                 15               0           bypass input D dff                 (d_pr)
    --                                                 16                0          bypass input C dff                 (c_pr)
    --                                                 17                 00        X0->bypass ; 01->1dff ; 11->2dff cascade output B
    --                                                 18                   00      X0->bypass ; 01->1dff ; 11->2dff B
    --                                                 19                     00    X0->bypass ; 01->1dff ; 11->2dff cascade output A
    --                                                 20                       00  X0->bypass ; 01->1dff ; 11->2dff A
    function raw_config1_0 return bit_vector is
        constant result : bit_vector(23 downto 0) := "000000011000100000010001";
    begin
        --return "000000011000100000010001";
        return result;
    end function;
    function raw_config1_1 return bit_vector is
        constant result : bit_vector(23 downto 0) := "000000011000100000110011";
    begin
        --return "000000011000100000110011";
        return result;
    end function;
    function raw_config1_2 return bit_vector is
        constant result : bit_vector(23 downto 0) := "000000011100100000110011";
    begin
        --return "000000011100100000110011";
        return result;
    end function;
    function raw_config1_3 return bit_vector is
        constant result : bit_vector(23 downto 0) := "000000010100100000110011";
    begin
        --return "000000010100100000110011";
        return result;
    end function;
    --
    -- constant raw_config2 : bit_vector(13 downto 0) := "00010100000011";
    --                                                   "00010100000011";
    --                                                   "00010110000011";
    --                                                   "00010110000011";
    --                                                 19 1              enable ovf reset                        (ovf_pr)
    --                                                 20  1             enable carry out reset                  (cyo_pr)
    --                                                 21   1            enable cascade carry out reset         (ccyo_pr)
    --                                                 22                enable Z out reset                        (z_pr)
    --                                                 23     1           enable cascade Z output/loopback reset   (cz_pr)
    --                                                 27      1          enable multiplier output reset            (m_pr)
    --                                                 24       1         enable Y reset                            (y_pr)
    --                                                 25        1        enable X reset                            (x_pr)
    --                                                 28         1       enable pre-adder output reset             (p_pr)
    --                                                 26          1      enable carry input reset                (cyi_pr)
    --                                                 29           1     enable D dff reset                        (d_pr)
    --                                                 30            1    enable C dff reset                        (c_pr)
    --                                                 31             1   enable B dff reset                        (b_pr)
    --                                                 32              1  enable A dff reset                        (a_pr)
    function raw_config2_0 return bit_vector is
        constant result : bit_vector(13 downto 0) := "00010100000011";
    begin
        --return "00010100000011";
        return result;
    end function;
    function raw_config2_1 return bit_vector is
        constant result : bit_vector(13 downto 0) := "00010100000011";
    begin
        --return "00010100000011";
        return result;
    end function;
    function raw_config2_2 return bit_vector is
        constant result : bit_vector(13 downto 0) := "00010110000011";
    begin
        --return "00010110000011";
        return result;
    end function;
    function raw_config2_3 return bit_vector is
        constant result : bit_vector(13 downto 0) := "00010110000011";
    begin
        --return "00010110000011";
        return result;
    end function;

    --signal C0 : std_logic;
    signal Z0       : std_logic_vector(55 downto 0);
    signal Z0_r     : std_logic_vector(17 downto 0);
    signal Z0_r1    : std_logic_vector(17 downto 0);
    signal Z0_r2    : std_logic_vector(17 downto 0);
    signal Z1       : std_logic_vector(55 downto 0);
    signal Z1_r     : std_logic_vector(5 downto 0);
    signal Z1_r1    : std_logic_vector(5 downto 0);
    signal Z2       : std_logic_vector(55 downto 0);
    signal Z2_r     : std_logic_vector(17 downto 0);
    signal Z3       : std_logic_vector(55 downto 0);

    signal A1 : std_logic_vector(23 downto 0);
    signal B1 : std_logic_vector(17 downto 0);

    signal A2 : std_logic_vector(23 downto 0);
    signal B2 : std_logic_vector(17 downto 0);

    signal A3 : std_logic_vector(23 downto 0);
    signal B3 : std_logic_vector(17 downto 0);

    signal A4 : std_logic_vector(23 downto 0);
    signal B4 : std_logic_vector(17 downto 0);

    signal A4_r : std_logic_vector(23 downto 0);
    signal B4_r : std_logic_vector(17 downto 0);

    signal cascade_Z0toZ1 : std_logic_vector(55 downto 0);
    signal cascade_Z1toZ2 : std_logic_vector(55 downto 0);
    signal cascade_Z2toZ3 : std_logic_vector(55 downto 0);

    signal shift_12 : std_logic_vector(55 downto 0);

    begin

        A1 <= A(23 downto 0);
        B1 <= B(17 downto 0);

        A2 <= A(23 downto 0);
        B2 <= B(35 downto 18);

        A3 <= A(47 downto 24);
        B3 <= B(17 downto 0);

        A4 <= A(47 downto 24);
        B4 <= B(35 downto 18);

        dsp_mult_0 : NX_DSP_U_WRAP
        generic map(
            raw_config0 => raw_config0_0,  -- bit_vector(26 downto 0);
            raw_config1 => raw_config1_0,  -- bit_vector(23 downto 0);
            raw_config2 => raw_config2_0,  -- bit_vector(13 downto 0);
            raw_config3 => (others => '0') -- bit_vector(2 downto 0)
        )
        port map(
            CK   => clk,
            R    => rst,
            RZ   => rst,
            WE   => '1',
            WEZ  => '1',

            CI   => '0',
            A    => A1,
            B    => B1,
            C    => (others => '0'),
            D    => (others => '0'),
            CAI  => (others => '0'),
            CBI  => (others => '0'),
            CZI  => (others => '0'),
            CCI  => '0',

            Z    => Z0,
            CO43 => open,
            CO57 => open,
            OVF  => open,
            CAO  => open,
            CBO  => open,
            CZO  => cascade_Z0toZ1,
            CCO  => open
        );

        dsp_mult_1 : NX_DSP_U_WRAP
        generic map(
            raw_config0 => raw_config0_1,  -- bit_vector(26 downto 0);
            raw_config1 => raw_config1_1,  -- bit_vector(23 downto 0);
            raw_config2 => raw_config2_1,  -- bit_vector(13 downto 0);
            raw_config3 => (others => '0') -- bit_vector(2 downto 0)
        )
        port map(
            CK   => clk,
            R    => rst,
            RZ   => rst,
            WE   => '1',
            WEZ  => '1',

            CI   => '0',
            A    => A2,
            B    => B2,
            C    => (others => '0'),
            D    => (others => '0'),
            CAI  => (others => '0'),
            CBI  => (others => '0'),
            CZI  => cascade_Z0toZ1,
            CCI  => '0',

            Z    => Z1,
            CO43 => open,
            CO57 => open,
            OVF  => open,
            CAO  => open,
            CBO  => open,
            CZO  => cascade_Z1toZ2,
            CCO  => open
        );

        dsp_mult_2 : NX_DSP_U_WRAP
        generic map(
            raw_config0 => raw_config0_2,  -- bit_vector(26 downto 0);
            raw_config1 => raw_config1_2,  -- bit_vector(23 downto 0);
            raw_config2 => raw_config2_2,  -- bit_vector(13 downto 0);
            raw_config3 => (others => '0') -- bit_vector(2 downto 0)
        )
        port map(
            CK   => clk,
            R    => rst,
            RZ   => rst,
            WE   => '1',
            WEZ  => '1',

            CI   => '0',
            A    => A3,
            B    => B3,
            C    => (others => '0'),
            D    => (others => '0'),
            CAI  => (others => '0'),
            CBI  => (others => '0'),
            CZI  => cascade_Z1toZ2,
            CCI  => '0',

            Z    => Z2,
            CO43 => open,
            CO57 => open,
            OVF  => open,
            CAO  => open,
            CBO  => open,
            CZO  => cascade_Z2toZ3,
            CCO  => open
        );

        shift_12(55 downto 56 - 12) <= (others => '0');
        shift_12(55 - 12 downto 0)           <= cascade_Z2toZ3(55 downto 12);

        dsp_mult_3 : NX_DSP_U_WRAP
        generic map(
            raw_config0 => raw_config0_3,  -- bit_vector(26 downto 0);
            raw_config1 => raw_config1_3,  -- bit_vector(23 downto 0);
            raw_config2 => raw_config2_3,  -- bit_vector(13 downto 0);
            raw_config3 => (others => '0') -- bit_vector(2 downto 0)
        )
        port map(
            CK   => clk,
            R    => rst,
            RZ   => rst,
            WE   => '1',
            WEZ  => '1',

            CI   => '0',
            A    => A4_r,
            B    => B4_r,
            C    => (others => '0'),
            D    => (others => '0'),
            CAI  => (others => '0'),
            CBI  => (others => '0'),
            CZI  => cascade_Z2toZ3,--shift_12,
            CCI  => '0',

            Z    => Z3,
            CO43 => open,
            CO57 => open,
            OVF  => open,
            CAO  => open,
            CBO  => open,
            CZO  => open,
            CCO  => open
        );

        input_pipe : process (clk)
        begin
            if rising_edge(clk) then
                A4_r <= A4;
                B4_r <= B4;
            end if;
        end process input_pipe;

        output_pipe : process (clk)
        begin
            if rising_edge(clk) then
                Z0_r    <= Z0(17 downto 0);
                Z0_r1   <= Z0_r;
                Z0_r2   <= Z0_r1;
                Z1_r    <= Z1(5 downto 0);
                Z1_r1   <= Z1_r;
                Z2_r    <= Z2(17 downto 0);
            end if;
        end process output_pipe;


    
    Z(17 downto 0)  <= Z0_r2;
    Z(23 downto 18) <= Z1_r1;
    Z(41 downto 24) <= Z2_r;
    Z(83 downto 42) <= Z3(41 downto 0);

end architecture;-- =================================================================================================
