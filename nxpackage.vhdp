    WA3  => WA3,
    WA4  => WA4,
    WA5  => WA5,
    WA6  => WA6,
    WE   => WE,
    WEA  => '0'
);

OUT_REG : for I in Q'range generate

    reg : NX_DFF
    generic map (
	dff_edge => rck_edge,
	dff_init => '0',
	dff_load => '1'
    )
    port map (
	CK => RCK,
	I  => D(I),
	L  => RE,
	R  => '0',
	O  => Q(I)
    );

end generate;

O1   <= Q(0);
O2   <= Q(1);
O3   <= Q(2);
O4   <= Q(3);
O5   <= Q(4);
O6   <= Q(5);
O7   <= Q(6);
O8   <= Q(7);
O9   <= Q(8);
O10  <= Q(9);
O11  <= Q(10);
O12  <= Q(11);
O13  <= Q(12);
O14  <= Q(13);
O15  <= Q(14);
O16  <= Q(15);

COR <= '0';
ERR <= '0';
end generate;
end NX_RTL;
