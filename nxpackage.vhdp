library ieee;
use ieee.std_logic_1164.all;

library NX;
use NX.nxPackage.all;

entity NX_CKS_U is
  port (
      CKI : in  std_logic;
      CMD : in  std_logic;
      CKO : out std_logic
  );
  end NX_CKS_U;

  architecture NX_SIMU of NX_CKS_U is

    component NX_GCK_U
      generic (
        INV_IN  : bit; -- No / Yes
        INV_OUT : bit; -- No / Yes
        std_mode    : string  -- MUX / CKS / BYPASS / CSC
        );
      port (
        SI1 : in  std_logic;
        SI2 : in  std_logic;
        CMD : in  std_logic;
        SO  : out std_logic
        );
    end component;
  
    
  begin
  
    ins_NX_GCK_U : NX_GCK_U
      generic map (
        INV_IN  => '0',
        INV_OUT => '0',
        std_mode    => "CKS")
      port map (
        SI1 => CKI,
        SI2 => '0',
        CMD => CMD,
        SO  => CKO
        );
  
      
  end NX_SIMU;
library ieee;
use ieee.std_logic_1164.all;

library NX;
use NX.nxPackage.all;

entity NX_CMUX_U is
  port (
    CKI0 : in  std_logic;
    CKI1 : in  std_logic;
    SEL  : in  std_logic;
    CKO  : out std_logic
    );
end NX_CMUX_U;

architecture NX_SIMU of NX_CMUX_U is

  component NX_GCK_U
    generic (
      INV_IN  : bit; -- No / Yes
      INV_OUT : bit; -- No / Yes
      std_mode    : string  -- MUX / CKS / BYPASS / CSC
      );
    port (
      SI1 : in  std_logic;
      SI2 : in  std_logic;
      CMD : in  std_logic;
      SO  : out std_logic
      );
  end component;

  
begin

  ins_NX_GCK_U : NX_GCK_U
    generic map (
      INV_IN  => '0',
      INV_OUT => '0',
      std_mode    => "MUX")
    port map (
      SI1 => CKI0,
      SI2 => CKI1,
      CMD => SEL,
      SO  => CKO
      );

    
end NX_SIMU;
