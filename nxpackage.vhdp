begin

fifo: NX_FIFO_U
generic map (
    mode           => 0, -- 0: DPREG
    wck_edge       => wck_edge,
    rck_edge       => rck_edge,
    use_write_arst => use_write_arst,
    use_read_arst  => use_read_arst
)
port map (
    RCK   => RCK,
    WCK   => WCK,
    WE    => WE,
    WEA   => WEA,
    I1    => I(0),
