ultra : if NX_SYMBOL = "NG_U" or NX_SYMBOL = "NG_C" generate
signal D : std_logic_vector(15 downto 0);
signal Q : std_logic_vector(15 downto 0);

begin
rfb: NX_RFB_U
generic map (
    mode      => 2, -- 2: DPREG_64x18
    wck_edge  => wck_edge,
    mem_ctxt  => mem_ctxt
)
port map (
    WCK  => WCK,
    I1   => I1,
    I2   => I2,
