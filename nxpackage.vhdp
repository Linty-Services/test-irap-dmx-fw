-- #}}}#
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity ACC84_2DSP is
    generic (
        g_pipe : integer := 2 -- range between [1 - 3]
    );
    port (
        -- Global
        clk : in std_logic := '0';
        rst : in std_logic := '0';
        -- 
        X   : in std_logic_vector(83 downto 0);
        Z   : out std_logic_vector(84 downto 0)
    );
end ACC84_2DSP;

architecture rtl of ACC84_2DSP is

    component NX_DSP_U_WRAP is
        generic (
            std_mode    : string                  := "";
            raw_config0 : bit_vector(26 downto 0) := B"000000000000000000000000000"; -- Mux test test test test
            raw_config1 : bit_vector(23 downto 0) := B"000000000000000000000000";    -- Pipe Mux
            raw_config2 : bit_vector(13 downto 0) := B"00000000000000";              -- Pipe Reset
            raw_config3 : bit_vector(2 downto 0)  := B"000"                          -- ALU operation
        );
        port (
            A    : in std_logic_vector(23 downto 0);
            B    : in std_logic_vector(17 downto 0);
            C    : in std_logic_vector(35 downto 0);
    
            CAI  : in std_logic_vector(23 downto 0);
            CAO  : out std_logic_vector(23 downto 0);
            CBI  : in std_logic_vector(17 downto 0);
            CBO  : out std_logic_vector(17 downto 0);
    
            CCI  : in std_logic;
            CCO  : out std_logic;
            CI   : in std_logic;
            CK   : in std_logic;
            CO43 : out std_logic;
            CO57 : out std_logic;
    
            CZI  : in std_logic_vector(55 downto 0);
            CZO  : out std_logic_vector(55 downto 0);
    
            D    : in std_logic_vector(17 downto 0);
    
            OVF  : out std_logic;
            R    : in std_logic;
            RZ   : in std_logic;
            WE   : in std_logic;
            WEZ  : in std_logic;
    
            Z    : out std_logic_vector(55 downto 0)
        );
    end component NX_DSP_U_WRAP;

    -- constant raw_config0 : bit_vector(26 downto 0) := "000010000000001001000000000";
    --                                                   "000000000000001011000000000";
    --                                                 33 1                            invert we
    --                                                 34  1                           invert wez
    --                                                 35   1                          invert rst
    --                                                 36    1                         invert rstz
    --                                                 45     0                        select bit42 pour cascade carry out (ccy_o)
    --                                                 41      1                       port C for dynamic operation
    --                                                 42       1                      port D for dynamic operation
    --                                                 43        xxxxxx                saturation rank
    --                                                 44              0               saturation {0->bypass ; 1->enable}
    --                                                 46               1              ALU {0->bypass ; 1->enable}
    --                                              50&51                00            cascade carry in {X0->input carry ; 01->cascade carry input ; 11->loopback carry}
    --                                                 48                  0           Y selector : {0->multiplier ; 1->A&B}
    --                                                 47                   0          Z input = {0->cascade ; 1->loopback}
    --                                                 49                    000       big mux selector
    --                                                 52                       0      0->bypass pre-adder ; 1->pre-adder
    --                                                 53                        0     0->B from core logic ; 1->B from cascade
    --                                                 54                         0    0->A from core logic ; 1->A from cascade
    --                                                 55                          0   pre-adder operation : {0->addition ; 1->substraction}
    --                                                 59                           1  signed mode
    function raw_config0_0 return bit_vector is
        constant result : bit_vector(26 downto 0) := "000010000000001001100000000";
    begin
        return result;
    end function;
    --
    function raw_config0_1 return bit_vector is
        constant result : bit_vector(26 downto 0) := "000000000000001011101100001";
    begin
        return result;
    end function;
    --
    -- constant raw_config1 : bit_vector(23 downto 0) := "000000010000001100010001";
    --                                                   "000000010011001100110011";
    --                                                  1 0                         bypass we dff                     (we_pr)
    --                                                  2  0                        bypass wez dff                   (wez_pr)
    --                                                  3   0                       bypass rst dff                   (rst_pr)
    --                                                  4    0                      bypass rstz dff                 (rstz_pr)
    --                                                  5     0                     bypass ovf dff                   (ovf_pr)
    --                                                  6      0                    bypass carry output dff          (cyo_pr)
    --                                                  7       0                   bypass cascade carry output dff (ccyo_pr)
    --                                                  8        0                  bypass Z output dff                (z_pr)
    --                                                  9         0                 bypass cascade Z output dff       (cz_pr)
    --                                                 10          0                bypass Y dff                       (y_pr)
    --                                                 11           0               bypass X dff                       (x_pr)
    --                                                 12            0              bypass carry input dff           (cyi_pr)
    --                                                 13             0             bypass multiplier dff              (m_pr)
    --                                                 14              0            bypass pre-adder dff               (p_pr)
    --                                                 15               0           bypass input D dff                 (d_pr)
    --                                                 16                0          bypass input C dff                 (c_pr)
    --                                                 17                 00        X0->bypass ; 01->1dff ; 11->2dff cascade output B
    --                                                 18                   00      X0->bypass ; 01->1dff ; 11->2dff B
    --                                                 19                     00    X0->bypass ; 01->1dff ; 11->2dff cascade output A
    --                                                 20                       00  X0->bypass ; 01->1dff ; 11->2dff A
    function raw_config1_0 return bit_vector is
        constant pipe0 : bit_vector(23 downto 0) := "000000011000000000000000";
        constant pipe1 : bit_vector(23 downto 0) := "000000011000000000010001";
        constant pipe2 : bit_vector(23 downto 0) := "000000011000000000110011";
    begin
        if g_pipe = 1 then
            return pipe0;
        elsif g_pipe = 2 then
            return pipe1;
        else
            return pipe2;
        end if;
    end function;
    function raw_config1_1 return bit_vector is
        constant pipe0 : bit_vector(23 downto 0) := "000000011000000000000000";
        constant pipe1 : bit_vector(23 downto 0) := "000000011000000000010001";
        constant pipe2 : bit_vector(23 downto 0) := "000000011000000000110011";
    begin
        if g_pipe = 1 then
            return pipe0;
        elsif g_pipe = 2 then
            return pipe1;
        else
            return pipe2;
        end if;
    end function;
    --
    -- constant raw_config2 : bit_vector(13 downto 0) := "01010000001111";
    --                                                   "00010001011111";
    --                                                 19 1               enable ovf reset                        (ovf_pr)
    --                                                 20  1              enable carry out reset                  (cyo_pr)
