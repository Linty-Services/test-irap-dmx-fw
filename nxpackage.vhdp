--NX_IOM_SERDES##{{{##
architecture NX_RTL of NX_IOM_SERDES is
begin

    process (RTCK) begin			-- Dummy input for syntax analysis
	report "Model NX_IOM_SERDES is superceded by NX_IOM_SERDES_M" severity note;
    end process;

base : NX_IOM_SERDES_M
generic map (
    data_size => data_size,
    location  => location 
)
port map (
    RTCK  => RTCK,
    WRCK  => WRCK,
    WTCK  => WTCK,
    RRCK  => RRCK,
    TRST  => TRST,
    RRST  => RRST,
    CTCK  => CTCK,
    DCK   => DCK,
    DRL   => DRL,
    DIG   => DIG,
    DS    => DS,
    DRA   => DRA,
    DRI   => DRI,
    FZ    => FZ,
    DRO   => DRO,
    DID   => DID,
    FLD   => FLD,
    FLG   => FLG,
    LINKN => LINKN,
    LINKP => LINKP
);

end NX_RTL;
