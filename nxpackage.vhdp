library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity NX_RAM_SLOWECC_1K_36_1r1w is
generic (
   mem_ctxt                     : string := ""                                     -- context initialization
);                                                                                  
port (                                                                              
   ACK                          : in  std_logic;
   BCK                          : in  std_logic;
                                                                                    
   AI                           : in  std_logic_vector(35 downto 0);  
   AO                           : out  std_logic_vector(35 downto 0);  
   AA                           : in  std_logic_vector(9 downto 0);               -- range 0 to 1023         
                                                                                    
   ACOR                         : out std_logic;                                    
   AERR                         : out std_logic;
                                 
   ACS                          : in  std_logic;
   AWE                          : in  std_logic;
   AR                           : in  std_logic;

   BCS                          : in  std_logic;
   BWE                          : in  std_logic;
   BR                           : in  std_logic
);
end NX_RAM_SLOWECC_1K_36_1r1w;

architecture NX_SIMU of NX_RAM_SLOWECC_1K_36_1r1w is

   signal addr_a               : std_logic_vector(15 downto 0);                   -- Port A address signal 
   signal addr_b               : std_logic_vector(15 downto 0);                   -- Port B address signal 

   signal AO1                  : std_logic_vector(23 downto 0);
   signal BO1                  : std_logic_vector(23 downto 0);

   signal AI1                  : std_logic_vector(23 downto 0);
   signal BI1                  : std_logic_vector(23 downto 0);

   signal ACOR1                : std_logic;                                    
   signal AERR1                : std_logic;                                    
   signal BCOR1                : std_logic;                                    
   signal BERR1                : std_logic;               

 component NX_RAM_SIMU_U is
   generic (
      std_mode                  : string := "";                                    -- standard mode [FAST_2kx18, SLOW_2kx18, NOECNOECC24, ...] empty for raw
      mcka_edge                 : bit := '0';                                      -- 0: rising edge for port A clock - 1: falling edge
      mckb_edge                 : bit := '0';                                      -- 0: rising edge for port B clock - 1: falling edge
      pcka_edge                 : bit := '0';                                      -- 0: rising edge for pipe A clock - 1: falling edge
      pckb_edge                 : bit := '0';                                      -- 0: rising edge for pipe B clock - 1: falling edge
                                                                                    
      pipe_ia                   : bit := '0';                                      -- 0: no pipe on port A input  - 1: pipe on port A input
      pipe_ib                   : bit := '0';                                      -- 0: no pipe on port B input  - 1: pipe on port B input
      pipe_oa                   : bit := '0';                                      -- 0: no pipe on port A output - 1: pipe on port A output
      pipe_ob                   : bit := '0';                                      -- 0: no pipe on port B output - 1: pipe on port B output
                                
      raw_config0               : bit_vector( 3 downto 0) := B"0000";			         -- PRC
      raw_config1               : bit_vector(15 downto 0) := B"0000000000000000";  -- MOD
                                                                                    
      -- For specific NG_LARGE Extended Features                                    
      raw_l_enable              : bit := '0';				                               -- '0' for NG-MEDIUM, '1' for NG-LARGE extended modes (NO_ECC x3 & x6) + scrubbing, test...
      raw_l_extend              : bit_vector( 3 downto 0) := B"0000";	             -- Extended modes for NG-LARGE (Scrubbing, test... )
                                                                             
      mem_ctxt                  : string := ""				                             -- context initialization
   );
   port (
      ACK	                      : in std_logic := '0';
      BCK	                      : in std_logic := '0';
     
      AI                        : in std_logic_vector(23 downto 0) := (others => '0');
      BI                        : in std_logic_vector(23 downto 0) := (others => '0');
                                 
      ACOR                      : out std_logic := '0';
      AERR                      : out std_logic := '0';
      BCOR                      : out std_logic := '0';
      BERR                      : out std_logic := '0';
     
      AO                        : out std_logic_vector(23 downto 0) := (others => '0');
      BO                        : out std_logic_vector(23 downto 0) := (others => '0');
      AA                        : in std_logic_vector(15 downto 0) := (others => '0');
                                 
      ACS                      	: in std_logic := '0';
      AWE                      	: in std_logic := '0';
      AR                        : in std_logic := '0';
                                 
      BA                        : in std_logic_vector(15 downto 0) := (others => '0');
                                 
      BCS                      	: in std_logic := '0';
      BWE                      	: in std_logic := '0';
      BR                        : in std_logic := '0'
   );
   end component NX_RAM_SIMU_U;

begin

   addr_a <= "000000"&AA;  -- Address reaches only 0x800, so we complement with 0x0 
   addr_b <= "000001"&AA;     

   AI1 <= "000000"&AI(17 downto 0);
   BI1 <= "000000"&AI(35 downto 18);

ram1: NX_RAM_SIMU_U
generic map (
   std_mode                     => "SLOW_2kx18",
   mcka_edge                    => '0',                                            -- "0: rising edge for port A clock - 1: falling edge"
   mckb_edge                    => '0',                                            -- "0: rising edge for port B clock - 1: falling edge"
   pcka_edge                    => '0',                                            -- "0: rising edge for pipe A clock - 1: falling edge"
   pckb_edge                    => '0',                                            -- "0: rising edge for pipe B clock - 1: falling edge"
   pipe_ia                      => '0',                                            -- "0: no pipe on port A input  - 1: pipe on port A input"
   pipe_ib                      => '0',                                            -- "0: no pipe on port B input  - 1: pipe on port A input"
   pipe_oa                      => '0',                                            -- "0: no pipe on port A output  - 1: pipe on port B output"
   pipe_ob                      => '0',                                            -- "0: no pipe on port B output  - 1: pipe on port B output"
   raw_config0                  => "0000",
   raw_config1                  => "1101100100100100",
   raw_l_enable                 => '0',
   raw_l_extend                 => "0000",
   mem_ctxt                     => mem_ctxt
)
port map(
   ACK                          => ACK,
   BCK                          => BCK,
                                
   AI                           => AI1,
   BI                           => BI1,
                                
   ACOR                         => ACOR1,
   AERR                         => AERR1,
   BCOR                         => BCOR1,
   BERR                         => BERR1,
                                
   AO                           => AO1,
   BO                           => BO1,
                                
   AA                           => addr_a,
   BA                           => addr_b,
                                
   ACS                          => ACS,
   AWE                          => AWE,
   AR                           => AR,   
                                
   BCS                          => BCS,
   BWE                          => BWE,
   BR                           => BR
);

AO <= BO1(17 downto 0) & AO1(17 downto 0);
ACOR <= ACOR1 or BCOR1;
AERR <= AERR1 or BERR1;

end NX_SIMU;
