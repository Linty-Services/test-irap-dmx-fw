entity UMUL24x36_1DSP_2CYCLES is
    generic (
        piped : boolean := true
    );
    port (
        -- Global
        clk : in std_logic := '0';
        rst : in std_logic := '0';
        -- 
        A   : in std_logic_vector(23 downto 0);
        B   : in std_logic_vector(17 downto 0);
        Z   : out std_logic_vector(59 downto 0)
    );
end UMUL24x36_1DSP_2CYCLES;

architecture rtl of UMUL24x36_1DSP_2CYCLES is

    -- Component NX_DSP_U_WRAP#{{{#
    component NX_DSP_U_WRAP is
        generic (
            std_mode    : string                  := "";
            raw_config0 : bit_vector(26 downto 0) := B"000000000000000000000000000"; -- Mux
            raw_config1 : bit_vector(23 downto 0) := B"000000000000000000000000";    -- Pipe Mux
            raw_config2 : bit_vector(13 downto 0) := B"00000000000000";              -- Pipe Reset
            raw_config3 : bit_vector(2 downto 0)  := B"000"                          -- ALU operation
        );
        port (
            A    : in std_logic_vector(23 downto 0);
            B    : in std_logic_vector(17 downto 0);
            C    : in std_logic_vector(35 downto 0);
    
            CAI  : in std_logic_vector(23 downto 0);
            CAO  : out std_logic_vector(23 downto 0);
            CBI  : in std_logic_vector(17 downto 0);
            CBO  : out std_logic_vector(17 downto 0);
    
            CCI  : in std_logic;
            CCO  : out std_logic;
            CI   : in std_logic;
            CK   : in std_logic;
            CO43 : out std_logic;
            CO57 : out std_logic;
    
            CZI  : in std_logic_vector(55 downto 0);
            CZO  : out std_logic_vector(55 downto 0);
    
            D    : in std_logic_vector(17 downto 0);
    
            OVF  : out std_logic;
            R    : in std_logic;
            RZ   : in std_logic;
            WE   : in std_logic;
            WEZ  : in std_logic;
    
            Z    : out std_logic_vector(55 downto 0)
        );
    end component NX_DSP_U_WRAP;
    --#}}}#

    -- dsp outputs
    signal Z1 : std_logic_vector(55 downto 0);
    signal Z1_r : std_logic_vector(17 downto 0);

    signal A1 : std_logic_vector(23 downto 0);
    signal B1 : std_logic_vector(17 downto 0);

    signal cascade : std_logic_vector(55 downto 0);

    begin

        A1 <= A;
        B1 <= B;

        dsp_mult_0 : NX_DSP_U_WRAP
        generic map(
            raw_config0 => b"000000000000001000011100000",  -- bit_vector(26 downto 0);
            raw_config1 => b"000000011000100000010001",  -- bit_vector(23 downto 0);
            raw_config2 => b"00001000000000",  -- bit_vector(13 downto 0);
            raw_config3 => b"000" -- bit_vector(2 downto 0)
        )
        port map(
            CK   => clk,
            R    => rst,
            RZ   => rst,
            WE   => '1',
            WEZ  => '1',

            CI   => '0',
            A    => A1,
            B    => B1,
            C    => (others => '0'),
            D    => (others => '0'),
            CAI  => (others => '0'),
            CBI  => (others => '0'),
            CZI  => cascade,
            CCI  => '0',

            Z    => Z1,
            CO43 => open,
            CO57 => open,
            OVF  => open,
            CAO  => open,
            CBO  => open,
            CZO  => cascade,
            CCO  => open
        );

        output_pipe : process (clk)
            begin
                if rising_edge(clk) then
                    Z1_r <= Z1(17 downto 0);
                end if;
            end process output_pipe;
        
        Z(17 downto 0)  <= Z1_r;
        Z(59 downto 18) <= Z1(41 downto 0);

