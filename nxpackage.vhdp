  ck0_edge        : bit := '0';
  ck1_edge        : bit := '0';
  ack_sel        : bit := '0';
  bck_sel        : bit := '0';
  use_adest_arst : bit_vector(1 downto 0) := "00";
  use_bdest_arst : bit_vector(1 downto 0) := "00";
  gt0_bypass_reg1 :bit := '0';
  gt0_bypass_reg2 :bit := '0';
  gt1_bypass_reg1 :bit := '0';
  gt1_bypass_reg2 :bit := '0'
);
port (
    CK1	: in std_logic := '0';
    CK2	: in std_logic := '0';
    ADRSTI	: in std_logic := '0';
    AI	: in std_logic_vector(5 downto 0) := (others => '0');
    AO	: out std_logic_vector(5 downto 0);
    BDRSTI	: in std_logic := '0';
    BI	: in std_logic_vector(5 downto 0) := (others => '0');
    BO	: out std_logic_vector(5 downto 0)
);
end component NX_CDC_L_2DFF;

